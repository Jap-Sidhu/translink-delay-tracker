# Copy to .env and fill in. .env is gitignored; never commit the real key.

# Required. Register at https://www.translink.ca/developer
TRANSLINK_API_KEY=your-api-key-here

# Optional. Defaults shown.
# DATABASE_URL=postgresql://tracker:tracker@localhost:5432/translink
# TRIP_POLL_SECONDS=120
# POSITION_POLL_SECONDS=600
# DAILY_REQUEST_BUDGET=950

# Optional. Only the database tests need this; they are skipped without it.
# TEST_DATABASE_URL=postgresql://tracker:tracker@localhost:5432/translink_test
